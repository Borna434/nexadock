<Window x:Class="NexaDock.UI.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NexaDock.UI.ViewModels"
        xmlns:b="clr-namespace:NexaDock.UI.Behaviors"
        xmlns:c="clr-namespace:NexaDock.UI.Controls"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DockViewModel}"
        Title="NexaDock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        b:HoverMotion.ReducedMotion="{Binding ReducedMotion}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WidgetTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <PlacementMode x:Key="DockToolTipPlacement">Top</PlacementMode>
            <sys:Double x:Key="DockToolTipOffset">-8</sys:Double>

            <Style TargetType="ToolTip">
                <Setter Property="Placement" Value="{DynamicResource DockToolTipPlacement}" />
                <Setter Property="VerticalOffset" Value="{DynamicResource DockToolTipOffset}" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#F4F6FB" />
                <Setter Property="Background" Value="#EE161A24" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The plate every widget tile sits on. -->
            <Style x:Key="TileHost" TargetType="Border">
                <Setter Property="Height" Value="{DynamicResource Bar.TileHeight}" />
                <Setter Property="CornerRadius" Value="{DynamicResource Bar.TileRadius}" />
                <Setter Property="Padding" Value="{DynamicResource Bar.TilePadding}" />
                <Setter Property="Background" Value="{DynamicResource Bar.TileFill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Bar.TileRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding HasPlate}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource Bar.TileHover}" />
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsCardOpen}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Bar.TileHover}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasPlate}" Value="False">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Margin="{Binding WindowPadding}">
        <!-- Soft shadow, only for the translucent fallback (DWM supplies none for layered windows). -->
        <Border CornerRadius="{Binding CornerRadius}" Background="{Binding Brushes.Tint}"
                Visibility="{Binding IsFallbackBackdrop, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.35" Color="{Binding Brushes.ShadowColor}" />
            </Border.Effect>
        </Border>

        <!-- Layered glass: tint, rising glow, sheen, rim. -->
        <Border x:Name="Glass" CornerRadius="{Binding CornerRadius}" Background="{Binding Brushes.Tint}" />
        <Border CornerRadius="{Binding CornerRadius}" Background="{Binding Brushes.InnerGlow}" IsHitTestVisible="False" />
        <Border CornerRadius="{Binding CornerRadius}" Background="{Binding Brushes.Sheen}" IsHitTestVisible="False" />
        <Border CornerRadius="{Binding CornerRadius}" BorderBrush="{Binding Brushes.Rim}" BorderThickness="1" IsHitTestVisible="False" />

        <ItemsControl x:Name="WidgetHost" ItemsSource="{Binding Widgets}" Margin="{Binding ContentPadding}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:BarPanel Gap="{Binding DataContext.Spacing, RelativeSource={RelativeSource AncestorType=Window}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="c:BarPanel.IsFlexible" Value="{Binding IsFlexible}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Tag="TileHost" Style="{StaticResource TileHost}" ToolTipService.InitialShowDelay="700">
                        <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource TileSelector}" VerticalAlignment="Center" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Right-click › Widgets… to add widgets" Foreground="{Binding Brushes.SecondaryForeground}"
                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Widgets.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
