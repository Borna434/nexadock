<Window x:Class="NexaDock.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NexaDock.UI.ViewModels"
        xmlns:c="clr-namespace:NexaDock.UI.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="{Binding Title}"
        ThemeMode="System"
        Width="780" Height="900"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <c:PercentConverter x:Key="Percent" />
        <c:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <c:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,26,0,10" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Width" Value="64" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <!-- Theme swatch card -->
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Theme" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outer" Width="106" CornerRadius="10" BorderThickness="2"
                                BorderBrush="Transparent" Padding="3" Background="Transparent">
                            <StackPanel>
                                <Border Height="58" CornerRadius="7" Background="{Binding Preview}">
                                    <Grid>
                                        <Border CornerRadius="7" BorderThickness="1" BorderBrush="#55FFFFFF">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#55FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="Aa" FontSize="18" FontWeight="SemiBold" Margin="10,0"
                                                   VerticalAlignment="Center" Foreground="{Binding PreviewForeground}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="4,6,4,0" />
                                <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" Margin="4,0,4,4" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="28,8,28,16">
            <StackPanel MaxWidth="820">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Image x:Name="HeaderIcon" Width="40" Height="40" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>

                <!-- Appearance -->
                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource Label}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Themes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ThemeOptionViewModel}">
                                    <RadioButton Style="{StaticResource ThemeCard}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding Name}"
                                                 Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Size" Style="{StaticResource Label}" />
                            <TextBlock Text="Tile and icon size preset" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="Size" Content="Small" IsChecked="{Binding IsSmall}" Margin="0,0,14,0" MinWidth="0" />
                            <RadioButton GroupName="Size" Content="Medium" IsChecked="{Binding IsMedium}" Margin="0,0,14,0" MinWidth="0" />
                            <RadioButton GroupName="Size" Content="Large" IsChecked="{Binding IsLarge}" MinWidth="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,4">
                            <TextBlock Text="Width" Style="{StaticResource Label}" />
                            <TextBlock Text="Grows to fit content" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Slider Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                Minimum="{Binding MinWidth}" Maximum="{Binding MaxWidth}"
                                Value="{Binding Width}" SmallChange="10" LargeChange="100"
                                IsSnapToTickEnabled="True" TickFrequency="10" AutomationProperties.Name="Dock width" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding Width, StringFormat={}{0:0} px}" />

                        <StackPanel Grid.Row="1" Margin="0,12,0,4">
                            <TextBlock Text="Icon spacing" Style="{StaticResource Label}" />
                        </StackPanel>
                        <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,8,0,0"
                                Minimum="{Binding MinSpacing}" Maximum="{Binding MaxSpacing}"
                                Value="{Binding Spacing}" IsSnapToTickEnabled="True" TickFrequency="1"
                                AutomationProperties.Name="Icon spacing" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Margin="0,8,0,0" Text="{Binding Spacing, StringFormat={}{0:0} px}" />

                        <StackPanel Grid.Row="2" Margin="0,12,0,4">
                            <TextBlock Text="Glass opacity" Style="{StaticResource Label}" />
                            <TextBlock Text="Strength of the tint layer" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,8,0,0"
                                Minimum="{Binding MinOpacity}" Maximum="{Binding MaxOpacity}"
                                Value="{Binding Opacity}" IsSnapToTickEnabled="True" TickFrequency="0.01"
                                AutomationProperties.Name="Glass opacity" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Margin="0,8,0,0" Text="{Binding Opacity, Converter={StaticResource Percent}}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Reduce motion" Style="{StaticResource Label}" />
                            <TextBlock Text="Turn off hover lift and scale animations" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ReducedMotion}" VerticalAlignment="Center"
                                  Content="" MinWidth="0" AutomationProperties.Name="Reduce motion" />
                    </Grid>
                </Border>

                <!-- Position -->
                <TextBlock Text="Position" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Screen edge" Style="{StaticResource Label}" />
                            <TextBlock Text="The Windows taskbar is left untouched" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="Edge" Content="Bottom" IsChecked="{Binding IsBottom}" Margin="0,0,14,0" MinWidth="0" />
                            <RadioButton GroupName="Edge" Content="Top" IsChecked="{Binding IsTop}" MinWidth="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Display" Style="{StaticResource Label}" />
                            <TextBlock Text="Falls back to the primary display if disconnected" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Monitors}"
                                  SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="Display" />
                        <Button Grid.Column="2" Margin="8,0,0,0" Content="Refresh" Command="{Binding RefreshMonitorsCommand}" VerticalAlignment="Center" />

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="Distance from edge" Style="{StaticResource Label}" />
                        </StackPanel>
                        <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,14,0,0"
                                Minimum="{Binding MinEdgeOffset}" Maximum="{Binding MaxEdgeOffset}"
                                Value="{Binding EdgeOffset}" IsSnapToTickEnabled="True" TickFrequency="1"
                                AutomationProperties.Name="Distance from edge" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Margin="0,14,0,0" Text="{Binding EdgeOffset, StringFormat={}{0:0} px}" />
                    </Grid>
                </Border>

                <!-- Shortcuts -->
                <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox ItemsSource="{Binding Shortcuts}" SelectedItem="{Binding SelectedShortcut}"
                                 MinHeight="160" MaxHeight="300" AutomationProperties.Name="Shortcuts"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ShortcutEditorItem}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" />
                                            <TextBlock Text="{Binding Target}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" MinWidth="150">
                            <Button Content="Add…" Command="{Binding AddShortcutCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                    Style="{DynamicResource AccentButtonStyle}" />
                            <Button Content="Remove" Command="{Binding RemoveShortcutCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                            <Button Content="Move up" Command="{Binding MoveUpCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                            <Button Content="Move down" Command="{Binding MoveDownCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,18" />
                            <Button Content="Restore defaults" Command="{Binding RestoreDefaultShortcutsCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="Add .exe files, shortcuts (.lnk), scripts or documents. Packaged Store apps can be added via their Start menu shortcut."
                           Style="{StaticResource Hint}" Margin="2,2,0,0" />

                <!-- About -->
                <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding BackdropDescription, StringFormat=Surface: {0}}" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DataDirectory, StringFormat=Settings stored in {0}}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                            <Button Content="Reset appearance" Command="{Binding ResetAppearanceCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="28,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Changes apply and save automatically" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0,0,14,0" />
                    <Button Content="Close" MinWidth="96" Click="OnCloseClick" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
