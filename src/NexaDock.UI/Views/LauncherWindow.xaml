<Window x:Class="NexaDock.UI.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NexaDock.UI.ViewModels"
        xmlns:l="clr-namespace:NexaDock.UI.Localization"
        xmlns:conv="clr-namespace:NexaDock.UI.Converters"
        Title="NexaDock Search"
        Width="680" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <conv:BoolToVisibilityConverter x:Key="LauncherBoolToVisibility" />
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Glass: tint, sheen and rim over the native blur (same look as the bar's cards). -->
        <Border x:Name="Surface" CornerRadius="10" Background="{DynamicResource Bar.Tint}" />
        <Border CornerRadius="10" Background="{DynamicResource Bar.Sheen}" IsHitTestVisible="False" />
        <Border CornerRadius="10" BorderBrush="{DynamicResource Bar.Rim}" BorderThickness="1" IsHitTestVisible="False" />

        <StackPanel Margin="14,12,14,12">
            <!-- Search field -->
            <Grid Margin="4,2,4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Bar.Accent}"
                           VerticalAlignment="Center" Margin="2,0,12,0" />
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="21" Background="Transparent" BorderThickness="0" Padding="0,4"
                             Foreground="{DynamicResource Bar.Foreground}" CaretBrush="{DynamicResource Bar.Foreground}"
                             SelectionBrush="{DynamicResource Bar.Accent}" FontFamily="Segoe UI Variable Display, Segoe UI"
                             PreviewKeyDown="OnSearchKeyDown" />
                    <TextBlock Text="{Binding Placeholder}" FontSize="21" Foreground="{DynamicResource Bar.Secondary}" Opacity="0.7"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0" FontFamily="Segoe UI Variable Display, Segoe UI">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Query}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- Results -->
            <Border Height="1" Background="{DynamicResource Bar.Separator}" Margin="0,4,0,6"
                    Visibility="{Binding HasRows, Converter={StaticResource LauncherBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LauncherRow}">
                        <Border x:Name="Row" CornerRadius="8" Padding="10,6" Margin="0,1" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonUp="OnRowClicked" MouseEnter="OnRowHover">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" MaxWidth="32" MaxHeight="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{DynamicResource Bar.Accent}" VerticalAlignment="Center" Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" Foreground="{DynamicResource Bar.Foreground}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource Bar.Secondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bar.HoverFill}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource Bar.Secondary}" Opacity="0.75" Margin="6,8,0,0" />
        </StackPanel>
    </Grid>
</Window>
