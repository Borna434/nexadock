<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NexaDock</AssemblyName>
    <RootNamespace>NexaDock.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\NexaDock.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NexaDock.Core\NexaDock.Core.csproj" />
    <ProjectReference Include="..\NexaDock.Infrastructure\NexaDock.Infrastructure.csproj" />
    <ProjectReference Include="..\NexaDock.Windows\NexaDock.Windows.csproj" />
    <ProjectReference Include="..\NexaDock.UI\NexaDock.UI.csproj" />
  </ItemGroup>
</Project>
