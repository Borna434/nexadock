<Window x:Class="NexaDock.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NexaDock.UI.ViewModels"
        xmlns:c="clr-namespace:NexaDock.UI.Converters"
        xmlns:l="clr-namespace:NexaDock.UI.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="{Binding Title}"
        ThemeMode="System"
        Width="860" Height="760"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <c:PercentConverter x:Key="Percent" />
        <c:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <c:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <c:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Width" Value="64" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <Style x:Key="Toggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Content" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="4,0,16,16" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
        </Style>

        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Theme" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outer" Width="112" CornerRadius="10" BorderThickness="2"
                                BorderBrush="Transparent" Padding="3" Background="Transparent">
                            <StackPanel>
                                <Border Height="54" CornerRadius="7" Background="{Binding Preview}">
                                    <Grid>
                                        <Border CornerRadius="7" BorderThickness="1" BorderBrush="#55FFFFFF">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#55FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="Aa" FontSize="18" FontWeight="SemiBold" Margin="10,0"
                                                   VerticalAlignment="Center" Foreground="{Binding PreviewForeground}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="4,6,4,4" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Day" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="28,16,28,8">
            <Image x:Name="HeaderIcon" Width="36" Height="36" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Hint}" />
            </StackPanel>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="24,4,12,0" TabStripPlacement="Left">
            <!-- ================================================================== Appearance -->
            <TabItem Header="{l:Loc settings.tab.appearance}">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc settings.tab.appearance}" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc appearance.style}" Style="{StaticResource Label}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Themes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ThemeOptionViewModel}">
                                            <RadioButton Style="{StaticResource ThemeCard}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         AutomationProperties.Name="{Binding Name}"
                                                         Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc appearance.language}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc appearance.languageHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center" ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Label" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc appearance.size}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc appearance.sizeHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton GroupName="Size" Content="S" IsChecked="{Binding IsSmall}" Margin="0,0,14,0" MinWidth="0" />
                                    <RadioButton GroupName="Size" Content="M" IsChecked="{Binding IsMedium}" Margin="0,0,14,0" MinWidth="0" />
                                    <RadioButton GroupName="Size" Content="L" IsChecked="{Binding IsLarge}" MinWidth="0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.ColumnSpan="2" Margin="0,4">
                                    <TextBlock Text="{l:Loc appearance.fullWidth}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc appearance.fullWidthHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" IsChecked="{Binding FullWidth}" AutomationProperties.Name="{l:Loc appearance.fullWidth}" />

                                <TextBlock Grid.Row="1" Text="{l:Loc appearance.spacing}" Style="{StaticResource Label}" Margin="0,12,0,4" />
                                <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,8,0,0"
                                        Minimum="{Binding MinSpacing}" Maximum="{Binding MaxSpacing}" Value="{Binding Spacing}"
                                        IsSnapToTickEnabled="True" TickFrequency="1" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Margin="0,8,0,0" Text="{Binding Spacing, StringFormat={}{0:0} px}" />

                                <StackPanel Grid.Row="2" Margin="0,12,0,4">
                                    <TextBlock Text="{l:Loc appearance.opacity}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc appearance.opacityHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,8,0,0"
                                        Minimum="{Binding MinOpacity}" Maximum="{Binding MaxOpacity}" Value="{Binding Opacity}"
                                        IsSnapToTickEnabled="True" TickFrequency="0.01" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Margin="0,8,0,0" Text="{Binding Opacity, Converter={StaticResource Percent}}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc appearance.refraction}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc appearance.refractionHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding LiquidRefraction}" AutomationProperties.Name="{l:Loc appearance.refraction}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc appearance.reduceMotion}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc appearance.reduceMotionHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ReducedMotion}" AutomationProperties.Name="{l:Loc appearance.reduceMotion}" />
                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                    <TextBlock Text="{l:Loc appearance.clock24}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc appearance.clock24Hint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <CheckBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Toggle}" Margin="0,14,0,0" IsChecked="{Binding Use24HourClock}" AutomationProperties.Name="{l:Loc appearance.clock24}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================== Widgets & profiles -->
            <TabItem Header="{l:Loc settings.tab.widgets}">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc settings.tab.widgets}" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{l:Loc widgets.layout}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc widgets.layoutHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{l:Loc widgets.manage}" Command="{Binding OpenWidgetPickerCommand}"
                                        Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{l:Loc widgets.pulse}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc widgets.pulseHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding PulseEnabled}" AutomationProperties.Name="{l:Loc widgets.pulse}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{l:Loc widgets.weatherCity}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc widgets.weatherCityHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding WeatherCity, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.Name="{l:Loc widgets.weatherCity}" KeyDown="OnCityKeyDown" />
                            </Grid>
                        </Border>

                        <!-- Profiles -->
                        <TextBlock Text="{l:Loc profiles.title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Loc profiles.intro}" Style="{StaticResource Hint}" Margin="0,0,0,10" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc profiles.auto}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc profiles.autoHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding AutoSwitchProfiles}" AutomationProperties.Name="{l:Loc profiles.auto}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- List + add/remove -->
                                <StackPanel Margin="0,0,16,0">
                                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="150" MaxHeight="260"
                                             AutomationProperties.Name="{l:Loc profiles.title}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                                                <StackPanel Margin="0,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Text="●" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <ComboBox Margin="0,8,0,6" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:Loc profiles.template}" />
                                    <Button Content="{l:Loc profiles.add}" Command="{Binding AddProfileCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                            Style="{DynamicResource AccentButtonStyle}" />
                                    <Button Content="{l:Loc profiles.remove}" Command="{Binding RemoveProfileCommand}" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- Editor -->
                                <StackPanel Grid.Column="1" DataContext="{Binding SelectedProfile}"
                                            Visibility="{Binding Converter={StaticResource NotNullToVisibility}}">
                                    <TextBlock Text="{l:Loc profiles.name}" Style="{StaticResource Hint}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,6" MaxLength="32" />
                                    <TextBlock Text="{Binding WidgetCountText}" Style="{StaticResource Hint}" Margin="0,0,0,10" />

                                    <CheckBox Content="{l:Loc profiles.schedule}" IsChecked="{Binding ScheduleEnabled}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding ScheduleEnabled}">
                                        <TextBlock Text="{l:Loc profiles.from}" Style="{StaticResource Label}" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding DataContext.TimeOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding From}" MinWidth="96" />
                                        <TextBlock Text="{l:Loc profiles.to}" Style="{StaticResource Label}" Margin="12,0,8,0" />
                                        <ComboBox ItemsSource="{Binding DataContext.TimeOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding To}" MinWidth="96" />
                                    </StackPanel>
                                    <WrapPanel Margin="0,0,0,4" IsEnabled="{Binding ScheduleEnabled}">
                                        <ToggleButton Style="{StaticResource Day}" Content="{l:Loc day.mon}" IsChecked="{Binding Monday}" />
                                        <ToggleButton Style="{StaticResource Day}" Content="{l:Loc day.tue}" IsChecked="{Binding Tuesday}" />
                                        <ToggleButton Style="{StaticResource Day}" Content="{l:Loc day.wed}" IsChecked="{Binding Wednesday}" />
                                        <ToggleButton Style="{StaticResource Day}" Content="{l:Loc day.thu}" IsChecked="{Binding Thursday}" />
                                        <ToggleButton Style="{StaticResource Day}" Content="{l:Loc day.fri}" IsChecked="{Binding Friday}" />
                                        <ToggleButton Style="{StaticResource Day}" Content="{l:Loc day.sat}" IsChecked="{Binding Saturday}" />
                                        <ToggleButton Style="{StaticResource Day}" Content="{l:Loc day.sun}" IsChecked="{Binding Sunday}" />
                                    </WrapPanel>
                                    <TextBlock Text="{l:Loc profiles.daysHint}" Style="{StaticResource Hint}" Margin="0,0,0,10" />

                                    <TextBlock Text="{l:Loc profiles.apps}" Style="{StaticResource Hint}" />
                                    <TextBox Text="{Binding AppsText, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,2" />
                                    <TextBlock Text="{l:Loc profiles.appsHint}" Style="{StaticResource Hint}" Margin="0,0,0,10" />

                                    <Button Content="{l:Loc profiles.activate}" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.ActivateProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================== Position & behavior -->
            <TabItem Header="{l:Loc settings.tab.position}">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc settings.tab.position}" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc position.edge}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc position.edgeHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton GroupName="Edge" Content="{l:Loc position.bottom}" IsChecked="{Binding IsBottom}" Margin="0,0,14,0" MinWidth="0" />
                                    <RadioButton GroupName="Edge" Content="{l:Loc position.top}" IsChecked="{Binding IsTop}" MinWidth="0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc position.display}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc position.displayHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Monitors}"
                                          SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="Label" />
                                <Button Grid.Column="2" Margin="8,0,0,0" Content="{l:Loc common.refresh}" Command="{Binding RefreshMonitorsCommand}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Text="{l:Loc position.offset}" Style="{StaticResource Label}" Margin="0,14,0,0" />
                                <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,14,0,0"
                                        Minimum="{Binding MinEdgeOffset}" Maximum="{Binding MaxEdgeOffset}" Value="{Binding EdgeOffset}"
                                        IsSnapToTickEnabled="True" TickFrequency="1" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Margin="0,14,0,0" Text="{Binding EdgeOffset, StringFormat={}{0:0} px}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{l:Loc behavior.title}" Style="{StaticResource SectionTitle}" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{l:Loc behavior.replace}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc behavior.replaceHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ReplaceTaskbar}" AutomationProperties.Name="{l:Loc behavior.replace}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc behavior.allDisplays}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc behavior.allDisplaysHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ShowOnAllDisplays}" AutomationProperties.Name="{l:Loc behavior.allDisplays}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc behavior.fullscreen}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc behavior.fullscreenHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding HideInFullscreen}" AutomationProperties.Name="{l:Loc behavior.fullscreen}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc behavior.startup}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{l:Loc behavior.startupHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding LaunchAtStartup}" AutomationProperties.Name="{l:Loc behavior.startup}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================= Pinned apps -->
            <TabItem Header="{l:Loc settings.tab.pinned}">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc settings.tab.pinned}" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding Shortcuts}" SelectedItem="{Binding SelectedShortcut}"
                                         MinHeight="200" MaxHeight="380" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShortcutEditorItem}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" />
                                                    <TextBlock Text="{Binding Target}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" MinWidth="150">
                                    <Button Content="{l:Loc pinned.add}" Command="{Binding AddShortcutCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                            Style="{DynamicResource AccentButtonStyle}" />
                                    <Button Content="{l:Loc pinned.remove}" Command="{Binding RemoveShortcutCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                    <Button Content="{l:Loc pinned.up}" Command="{Binding MoveUpCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                    <Button Content="{l:Loc pinned.down}" Command="{Binding MoveDownCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,18" />
                                    <Button Content="{l:Loc pinned.restore}" Command="{Binding RestoreDefaultShortcutsCommand}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="{l:Loc pinned.hint}" Style="{StaticResource Hint}" Margin="2,2,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================================= Calendars -->
            <TabItem Header="{l:Loc settings.tab.calendar}" Tag="calendar">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel DataContext="{Binding Calendar}">
                        <TextBlock Text="{l:Loc settings.tab.calendar}" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />

                        <!-- Google account -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc google.title}" Style="{StaticResource Label}" />
                                <TextBlock Text="{l:Loc google.intro}" Style="{StaticResource Hint}" TextWrapping="Wrap" />

                                <!-- 1. One-time setup: the user's own OAuth client -->
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasGoogleClient, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="{l:Loc google.setupTitle}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{l:Loc google.setupSteps}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <Button Content="{l:Loc google.openCloud}" Command="{Binding OpenGoogleCloudCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                                    <TextBlock Text="{l:Loc google.clientId}" FontSize="12" Opacity="0.8" />
                                    <TextBox Text="{Binding ClientIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                                    <TextBlock Text="{l:Loc google.clientSecret}" FontSize="12" Opacity="0.8" />
                                    <TextBox Text="{Binding ClientSecretInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                                    <Button Content="{l:Loc google.saveClient}" Command="{Binding SaveGoogleClientCommand}" HorizontalAlignment="Left"
                                            Style="{DynamicResource AccentButtonStyle}" />
                                </StackPanel>

                                <!-- 2. Sign in -->
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding CanSignIn, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{l:Loc google.signIn}" Command="{Binding SignInGoogleCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
                                        <Button Content="{l:Loc google.cancel}" Command="{Binding CancelSignInCommand}" Margin="8,0,0,0"
                                                Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <Button Content="{l:Loc google.changeClient}" Command="{Binding ChangeGoogleClientCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>

                                <!-- 3. Signed in: choose calendars -->
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsGoogleSignedIn, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock Text="{Binding GoogleAccount}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Content="{l:Loc google.signOut}" Command="{Binding SignOutGoogleCommand}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{l:Loc google.chooseHint}" Style="{StaticResource Hint}" Margin="0,6,0,6" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding GoogleCalendars}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="{Binding GoogleMessage}" Foreground="#FFE0A030" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Calendars linked by iCal address -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc ical.title}" Style="{StaticResource Label}" />
                                <TextBlock Text="{l:Loc ical.intro}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Feeds}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button Content="{l:Loc ical.remove}" Command="{Binding Remove}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="60" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,10,0,6" />
                                <Grid>
                                    <TextBlock Text="{Binding InputMessage}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,120,0" />
                                    <Button Content="{l:Loc ical.add}" Command="{Binding ConnectCommand}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{l:Loc calendar.privacySettings}" Style="{StaticResource Hint}" Margin="2,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================================= About -->
            <TabItem Header="{l:Loc settings.tab.about}">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc settings.tab.about}" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding VersionText}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding BackdropDescription}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource Hint}" Margin="0,4,0,12" />
                                <TextBlock Text="{l:Loc about.privacy}" Style="{StaticResource Hint}" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{l:Loc about.openData}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                                    <Button Content="{l:Loc about.reset}" Command="{Binding ResetAppearanceCommand}" />
                                </StackPanel>
                                <TextBlock Text="{l:Loc update.title}" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,0" />
                                <StackPanel DataContext="{Binding Updates}">
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" Margin="0,4,0,8" TextWrapping="Wrap" />
                                    <ProgressBar Height="4" Maximum="100" Value="{Binding Progress}" Margin="0,0,0,8"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{l:Loc update.check}" Command="{Binding CheckCommand}" Margin="0,0,8,0" />
                                        <Button Content="{l:Loc update.install}" Command="{Binding InstallCommand}" Style="{DynamicResource AccentButtonStyle}"
                                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{l:Loc backup.title}" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,0" />
                                <TextBlock Text="{l:Loc backup.hint}" Style="{StaticResource Hint}" Margin="0,4,0,8" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{l:Loc backup.export}" Command="{Binding ExportBackupCommand}" Margin="0,0,8,0" />
                                    <Button Content="{l:Loc backup.import}" Command="{Binding ImportBackupCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding BackupMessage}" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="28,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0,0,260,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{l:Loc settings.autosave}" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0,0,14,0" />
                    <Button Content="{l:Loc common.close}" MinWidth="96" Click="OnCloseClick" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
