<Window x:Class="NexaDock.UI.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:NexaDock.UI.Views"
        xmlns:b="clr-namespace:NexaDock.UI.Behaviors"
        Title="NexaDock preview"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        Left="-32000" Top="-32000"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WidgetTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root">
        <Border x:Name="Glass" Background="{DynamicResource Bar.Tint}" />
        <Border x:Name="Sheen" Background="{DynamicResource Bar.Sheen}" IsHitTestVisible="False" Opacity="0.6" />
        <Border x:Name="Rim" BorderBrush="{DynamicResource Bar.Rim}" BorderThickness="1" IsHitTestVisible="False" />
        <ItemsControl x:Name="Items" Margin="10" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type v:PreviewItem}">
                    <Grid Width="232" Margin="4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Card.Body}" FontSize="12" MaxWidth="170" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource Bar.GlyphButton}" Width="24" Height="24" FontSize="10" HorizontalAlignment="Right"
                                    Content="&#xE8BB;" ToolTip="Close window" Click="OnCloseClick" />
                        </Grid>
                        <Button Grid.Row="1" Style="{StaticResource Bar.PlainButton}" Click="OnActivateClick" ToolTip="{Binding Title}"
                                b:HoverMotion.HoverScale="1.02">
                            <Border x:Name="Thumb" Tag="Thumb" Width="224" Height="132" CornerRadius="6" Background="{DynamicResource Bar.Track}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
