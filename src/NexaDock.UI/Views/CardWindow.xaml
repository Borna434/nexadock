<Window x:Class="NexaDock.UI.Views.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexaDock card"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Left="-32000" Top="-32000"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WidgetTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="#F4F6FB" />
                <Setter Property="Background" Value="#EE161A24" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root">
        <Border x:Name="Shadow" Visibility="Collapsed" Background="{DynamicResource Bar.Tint}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.4" />
            </Border.Effect>
        </Border>
        <Border x:Name="Glass" Background="{DynamicResource Bar.Tint}" />
        <Border x:Name="Glow" Background="{DynamicResource Bar.InnerGlow}" IsHitTestVisible="False" />
        <Border x:Name="Sheen" Background="{DynamicResource Bar.Sheen}" IsHitTestVisible="False" Opacity="0.7" />
        <Border x:Name="Rim" BorderBrush="{DynamicResource Bar.Rim}" BorderThickness="1" IsHitTestVisible="False" />
        <ContentPresenter x:Name="Body" Margin="18,16,18,18" ContentTemplateSelector="{StaticResource CardSelector}" />
    </Grid>
</Window>
