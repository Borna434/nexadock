<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF + WinForms implicit usings collide (Application, Button, ...). Keep usings explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\NexaDock.ico" LogicalName="NexaDock.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NexaDock.Core\NexaDock.Core.csproj" />
  </ItemGroup>
</Project>
