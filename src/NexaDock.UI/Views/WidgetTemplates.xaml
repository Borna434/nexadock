<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:w="clr-namespace:NexaDock.UI.Widgets"
                    xmlns:c="clr-namespace:NexaDock.UI.Controls"
                    xmlns:conv="clr-namespace:NexaDock.UI.Converters"
                    xmlns:b="clr-namespace:NexaDock.UI.Behaviors"
                    xmlns:l="clr-namespace:NexaDock.UI.Localization"
                    xmlns:svc="clr-namespace:NexaDock.UI.Services"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared resources ===================================================================== -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:PercentToScaleConverter x:Key="PercentToScale" />
    <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:AllFalseToVisibilityConverter x:Key="AllFalseToVisibility" />
    <conv:WidgetTemplateSelector x:Key="TileSelector" />
    <conv:WidgetTemplateSelector x:Key="CardSelector" Card="True" />

    <!-- Defaults so templates resolve before the theme is applied. -->
    <SolidColorBrush x:Key="Bar.Foreground" Color="White" />
    <SolidColorBrush x:Key="Bar.Secondary" Color="#B0FFFFFF" />
    <SolidColorBrush x:Key="Bar.Accent" Color="#8AB4FF" />
    <SolidColorBrush x:Key="Bar.HoverFill" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="Bar.Track" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="Bar.Separator" Color="#22FFFFFF" />

    <Style x:Key="Bar.Text" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Bar.Foreground}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource Bar.PrimaryFont}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Bar.SubText" TargetType="TextBlock" BasedOn="{StaticResource Bar.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Bar.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Bar.SecondaryFont}" />
    </Style>

    <Style x:Key="Card.Title" TargetType="TextBlock" BasedOn="{StaticResource Bar.Text}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Card.Label" TargetType="TextBlock" BasedOn="{StaticResource Bar.Text}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Bar.Secondary}" />
    </Style>

    <Style x:Key="Card.Body" TargetType="TextBlock" BasedOn="{StaticResource Bar.Text}">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Transparent button with a soft hover plate; used for glyphs and app icons. -->
    <Style x:Key="Bar.PlainButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Bar.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="b:HoverMotion.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Plate" Opacity="0" CornerRadius="9"
                                Background="{DynamicResource Bar.HoverFill}" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Bar.GlyphButton" TargetType="Button" BasedOn="{StaticResource Bar.PlainButton}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="b:HoverMotion.HoverScale" Value="1.06" />
    </Style>

    <Style x:Key="Card.Button" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Bar.Foreground}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource Bar.TileFill}" BorderBrush="{DynamicResource Bar.TileRim}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bar.TileHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A thin horizontal progress bar; Tag holds 0..100. -->
    <Style x:Key="Card.Progress" TargetType="Border">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource Bar.Track}" />
    </Style>

    <DataTemplate x:Key="MonthCalendarView" DataType="{x:Type w:MonthCalendar}">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Card.Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="11" Command="{Binding PreviousCommand}" ToolTip="{l:Loc calendar.previous}">&#xE76B;</Button>
                    <Button Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="11" Command="{Binding NextCommand}" ToolTip="{l:Loc calendar.next}">&#xE76C;</Button>
                </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding WeekdayNames}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Card.Label}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:CalendarDay}">
                        <Grid Width="34" Height="30">
                            <Border x:Name="Today" CornerRadius="15" Width="28" Height="28" Background="{DynamicResource Bar.Accent}" Visibility="Collapsed" />
                            <TextBlock x:Name="Num" Text="{Binding Text}" Style="{StaticResource Card.Body}" FontSize="12.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse x:Name="Dot" Width="4" Height="4" Fill="{DynamicResource Bar.Accent}" VerticalAlignment="Bottom"
                                     HorizontalAlignment="Center" Margin="0,0,0,1" Visibility="Collapsed" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasEvents}" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                                <Setter TargetName="Num" Property="Opacity" Value="0.35" />
                                <Setter TargetName="Dot" Property="Opacity" Value="0.35" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Bar.Secondary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Today" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Num" Property="Foreground" Value="White" />
                                <Setter TargetName="Num" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Dot" Property="Fill" Value="White" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- Apps ================================================================================= -->
    <DataTemplate x:Key="AppsWidget.Tile" DataType="{x:Type w:AppsWidget}">
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Bar.PlainButton}" Command="{Binding OpenStartCommand}" ToolTip="{l:Loc apps.start}"
                    Width="{DynamicResource Bar.AppButton}" Height="{DynamicResource Bar.TileHeight}" AutomationProperties.Name="{l:Loc apps.start}">
                <!-- NexaDock's own start mark: four soft glass squares. -->
                <UniformGrid Rows="2" Columns="2" Width="{DynamicResource Bar.IconSize}" Height="{DynamicResource Bar.IconSize}" Margin="3">
                    <UniformGrid.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3.5" />
                            <Setter Property="Margin" Value="1.4" />
                        </Style>
                    </UniformGrid.Resources>
                    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7FB2FF" Offset="0" /><GradientStop Color="#3D7BFF" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8FD9FF" Offset="0" /><GradientStop Color="#3FA3F5" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#9B8CFF" Offset="0" /><GradientStop Color="#5B5CF0" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7FE3D2" Offset="0" /><GradientStop Color="#2FB8A6" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                </UniformGrid>
            </Button>

            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:AppItemViewModel}">
                        <Button Style="{StaticResource Bar.PlainButton}" Command="{Binding ClickCommand}"
                                Tag="AppItem" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}"
                                Width="{DynamicResource Bar.AppButton}" Height="{DynamicResource Bar.TileHeight}">
                            <Grid Width="{DynamicResource Bar.AppButton}" Height="{DynamicResource Bar.TileHeight}">
                                <Border x:Name="ActivePlate" CornerRadius="10" Margin="2" Background="{DynamicResource Bar.HoverFill}" Visibility="Collapsed" />
                                <Grid Width="{DynamicResource Bar.IconSize}" Height="{DynamicResource Bar.IconSize}" Margin="0,0,0,3">
                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True" />
                                    <Border CornerRadius="8" Background="{DynamicResource Bar.Accent}"
                                            Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="{Binding Monogram}" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <Border x:Name="Indicator" Height="3" Width="6" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                        Background="{DynamicResource Bar.Secondary}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="ActivePlate" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Indicator" Property="Width" Value="16" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Bar.Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- Clock ================================================================================ -->
    <DataTemplate x:Key="ClockWidget.Tile" DataType="{x:Type w:ClockWidget}">
        <StackPanel VerticalAlignment="Center" MinWidth="58">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Time}" Style="{StaticResource Bar.Text}" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                <TextBlock Text="{Binding Meridiem}" Style="{StaticResource Bar.SubText}" Margin="3,0,0,1" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock Text="{Binding Date}" Style="{StaticResource Bar.SubText}" HorizontalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ClockWidget.Card" DataType="{x:Type w:ClockWidget}">
        <StackPanel Width="290">
            <TextBlock Text="{Binding LongTime}" Style="{StaticResource Bar.Text}" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LongDate}" Style="{StaticResource Card.Body}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding WeekText}" Style="{StaticResource Card.Label}" Margin="0,2,0,14" />
            <ContentPresenter Content="{Binding Calendar}" ContentTemplate="{StaticResource MonthCalendarView}" />
            <Button Style="{StaticResource Card.Button}" Content="{l:Loc clock.settings}" Margin="0,12,0,0"
                    HorizontalAlignment="Left" Command="{Binding OpenDateTimeSettingsCommand}" />
            <Border Height="1" Background="{DynamicResource Bar.Separator}" Margin="0,14,0,12" />
            <ContentPresenter Content="{Binding Feed}" ContentTemplate="{DynamicResource AgendaView}" />
        </StackPanel>
    </DataTemplate>

    <!-- Day number =========================================================================== -->
    <DataTemplate x:Key="CalendarWidget.Tile" DataType="{x:Type w:CalendarWidget}">
        <Grid>
        <Ellipse Width="5" Height="5" Fill="{DynamicResource Bar.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,-4,0"
                 Visibility="{Binding Feed.HasEventsToday, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel VerticalAlignment="Center" MinWidth="26">
            <TextBlock Text="{Binding Weekday}" Foreground="{DynamicResource Bar.Accent}" FontFamily="{StaticResource UiFont}"
                       FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Day}" Style="{StaticResource Bar.Text}" FontFamily="{StaticResource DisplayFont}"
                       FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-3,0,0" />
        </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="CalendarWidget.Card" DataType="{x:Type w:CalendarWidget}">
        <StackPanel Width="290">
            <ContentPresenter Content="{Binding Calendar}" ContentTemplate="{StaticResource MonthCalendarView}" />
            <Button Style="{StaticResource Card.Button}" Content="{l:Loc calendar.today}" Margin="0,10,0,0" HorizontalAlignment="Left"
                    Command="{Binding Calendar.GoToTodayCommand}" />
            <Border Height="1" Background="{DynamicResource Bar.Separator}" Margin="0,14,0,12" />
            <ContentPresenter Content="{Binding Feed}" ContentTemplate="{DynamicResource AgendaView}" />
        </StackPanel>
    </DataTemplate>

    <!-- Day progress ========================================================================= -->
    <DataTemplate x:Key="DayProgressWidget.Tile" DataType="{x:Type w:DayProgressWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <c:RingGauge Width="24" Height="24" Value="{Binding Day}" StrokeThickness="3"
                         Track="{DynamicResource Bar.Track}" Fill="{DynamicResource Bar.Accent}" />
            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DayText}" Style="{StaticResource Bar.Text}" FontWeight="SemiBold" />
                <TextBlock Text="{l:Loc progress.ofToday}" Style="{StaticResource Bar.SubText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DayProgressWidget.Card" DataType="{x:Type w:DayProgressWidget}">
        <StackPanel Width="260">
            <TextBlock Text="{l:Loc progress.title}" Style="{StaticResource Card.Title}" />
            <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Card.Label}" Margin="0,2,0,14" />
            <TextBlock Text="{l:Loc progress.today}" Style="{StaticResource Card.Label}" />
            <Border Style="{StaticResource Card.Progress}" Margin="0,4,0,12">
                <Border CornerRadius="3" Background="{DynamicResource Bar.Accent}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding Day, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                </Border>
            </Border>
            <TextBlock Text="{l:Loc progress.week}" Style="{StaticResource Card.Label}" />
            <Border Style="{StaticResource Card.Progress}" Margin="0,4,0,12">
                <Border CornerRadius="3" Background="{DynamicResource Bar.Accent}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding Week, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                </Border>
            </Border>
            <TextBlock Text="{l:Loc progress.month}" Style="{StaticResource Card.Label}" />
            <Border Style="{StaticResource Card.Progress}" Margin="0,4,0,12">
                <Border CornerRadius="3" Background="{DynamicResource Bar.Accent}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding Month, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                </Border>
            </Border>
            <TextBlock Text="{l:Loc progress.year}" Style="{StaticResource Card.Label}" />
            <Border Style="{StaticResource Card.Progress}" Margin="0,4,0,0">
                <Border CornerRadius="3" Background="{DynamicResource Bar.Accent}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding Year, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                </Border>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- CPU & memory ========================================================================= -->
    <DataTemplate x:Key="SystemWidget.Tile" DataType="{x:Type w:SystemWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="30" Height="30" ToolTip="{l:Loc system.processor}">
                <c:RingGauge Value="{Binding Cpu}" StrokeThickness="3" Track="{DynamicResource Bar.Track}" Fill="{DynamicResource Bar.Accent}" />
                <TextBlock Text="{Binding Cpu, StringFormat={}{0:0}}" Style="{StaticResource Bar.Text}" FontSize="9.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Margin="6,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc system.cpu}" Style="{StaticResource Bar.SubText}" />
                <TextBlock Text="{Binding CpuText}" Style="{StaticResource Bar.Text}" FontWeight="SemiBold" FontSize="12" />
            </StackPanel>
            <Grid Width="30" Height="30" ToolTip="{l:Loc system.memory}">
                <c:RingGauge Value="{Binding Memory}" StrokeThickness="3" Track="{DynamicResource Bar.Track}" Fill="#5EE6C8" />
                <TextBlock Text="{Binding Memory, StringFormat={}{0:0}}" Style="{StaticResource Bar.Text}" FontSize="9.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc system.ram}" Style="{StaticResource Bar.SubText}" />
                <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Bar.Text}" FontWeight="SemiBold" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ProcessRow">
        <Grid Margin="0,3">
            <TextBlock Text="{Binding Name}" Style="{StaticResource Card.Body}" FontSize="12.5" Margin="0,0,70,0" />
            <TextBlock Text="{Binding Display}" Style="{StaticResource Card.Label}" HorizontalAlignment="Right" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SystemWidget.Card" DataType="{x:Type w:SystemWidget}">
        <StackPanel Width="290">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="78" Height="78">
                        <c:RingGauge Value="{Binding Cpu}" StrokeThickness="7" Track="{DynamicResource Bar.Track}" Fill="{DynamicResource Bar.Accent}" />
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource Card.Title}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{l:Loc system.processor}" Style="{StaticResource Card.Label}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Grid Width="78" Height="78">
                        <c:RingGauge Value="{Binding Memory}" StrokeThickness="7" Track="{DynamicResource Bar.Track}" Fill="#5EE6C8" />
                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Card.Title}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Card.Label}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{l:Loc system.busyCpu}" Style="{StaticResource Card.Label}" FontWeight="SemiBold" Margin="0,0,0,2" />
            <ItemsControl ItemsSource="{Binding TopCpu}" ItemTemplate="{StaticResource ProcessRow}" />
            <TextBlock Text="{l:Loc system.collecting}" Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Card.Label}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TopCpu.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{l:Loc system.busyMemory}" Style="{StaticResource Card.Label}" FontWeight="SemiBold" Margin="0,12,0,2" />
            <ItemsControl ItemsSource="{Binding TopMemory}" ItemTemplate="{StaticResource ProcessRow}" />
            <Grid Margin="0,12,0,0">
                <TextBlock Text="{Binding Uptime}" Style="{StaticResource Card.Label}" VerticalAlignment="Center" />
                <Button Style="{StaticResource Card.Button}" Content="{l:Loc system.taskManager}" HorizontalAlignment="Right" Command="{Binding OpenTaskManagerCommand}" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Weather ============================================================================== -->
    <DataTemplate x:Key="WeatherWidget.Tile" DataType="{x:Type w:WeatherWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <c:WeatherIcon Kind="{Binding Kind}" Width="28" Height="28" />
            <StackPanel Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Temperature}" Style="{StaticResource Bar.Text}" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                <TextBlock Text="{Binding Location}" Style="{StaticResource Bar.SubText}" MaxWidth="90" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Bar.SubText}" Margin="6,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="WeatherWidget.Card" DataType="{x:Type w:WeatherWidget}">
        <StackPanel Width="280">
            <TextBlock Text="{Binding Location}" Style="{StaticResource Card.Title}" />
            <Grid Margin="0,10,0,6">
                <StackPanel Orientation="Horizontal">
                    <c:WeatherIcon Kind="{Binding Kind}" Width="58" Height="58" />
                    <TextBlock Text="{Binding Temperature}" Style="{StaticResource Bar.Text}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="44" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Condition}" Style="{StaticResource Card.Body}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Range}" Style="{StaticResource Card.Label}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Details}" Style="{StaticResource Card.Label}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding Forecast}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:ForecastDay}">
                        <Border CornerRadius="10" Background="{DynamicResource Bar.TileFill}" BorderBrush="{DynamicResource Bar.TileRim}" BorderThickness="1"
                                Margin="3,0" Padding="4,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Day}" Style="{StaticResource Card.Label}" HorizontalAlignment="Center" />
                                <c:WeatherIcon Kind="{Binding Kind}" Width="26" Height="26" Margin="0,4" />
                                <TextBlock Text="{Binding High}" Style="{StaticResource Card.Body}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Low}" Style="{StaticResource Card.Label}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{l:Loc weather.credit}" Style="{StaticResource Card.Label}" FontSize="10.5" Margin="0,10,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Now playing ========================================================================== -->
    <DataTemplate x:Key="NowPlayingWidget.Tile" DataType="{x:Type w:NowPlayingWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="{DynamicResource Bar.ArtSize}" Height="{DynamicResource Bar.ArtSize}">
                <Border CornerRadius="7" Background="{DynamicResource Bar.Track}">
                    <TextBlock Text="{Binding NoteGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource Bar.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="7" Visibility="{Binding HasArt, Converter={StaticResource BoolToVisibility}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
            <StackPanel Margin="8,0,4,0" VerticalAlignment="Center" MaxWidth="150">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Bar.Text}" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Artist}" Style="{StaticResource Bar.SubText}" />
            </StackPanel>
            <Button Style="{StaticResource Bar.GlyphButton}" Command="{Binding PlayPauseCommand}" Content="{Binding PlayPauseGlyph}"
                    ToolTip="{l:Loc media.playPause}" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NowPlayingWidget.Card" DataType="{x:Type w:NowPlayingWidget}">
        <Grid>
        <!-- The cover's colour washes over the top of the card. -->
        <Border CornerRadius="12" Margin="-16,-16,-16,0" Height="260" VerticalAlignment="Top" Background="{Binding ArtTint}" IsHitTestVisible="False" />
        <StackPanel Width="280">
            <Border CornerRadius="14" Width="280" Height="280" Background="{DynamicResource Bar.Track}">
                <Grid>
                    <TextBlock Text="{Binding NoteGlyph}" FontFamily="{StaticResource IconFont}" FontSize="64"
                               Foreground="{DynamicResource Bar.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border CornerRadius="14" Visibility="{Binding HasArt, Converter={StaticResource BoolToVisibility}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Card.Title}" Margin="0,14,0,0" />
            <TextBlock Text="{Binding Artist}" Style="{StaticResource Card.Body}" Foreground="{DynamicResource Bar.Secondary}" />
            <TextBlock Text="{Binding Source}" Style="{StaticResource Card.Label}" FontSize="11" Margin="0,2,0,0" />
            <StackPanel Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                <Border Style="{StaticResource Card.Progress}" Height="4"
                        Visibility="{Binding CanSeek, Converter={StaticResource InverseBoolToVisibility}}">
                    <Border CornerRadius="2" Background="{DynamicResource Bar.Foreground}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding ProgressPercent, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                    </Border>
                </Border>
                <c:SeekSlider Style="{StaticResource Card.Slider}" Position="{Binding ProgressPercent}" SeekCommand="{Binding SeekCommand}"
                              Visibility="{Binding CanSeek, Converter={StaticResource BoolToVisibility}}" ToolTip="{l:Loc media.seek}" />
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="{Binding PositionText}" Style="{StaticResource Card.Label}" FontSize="11" />
                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource Card.Label}" FontSize="11" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Style="{StaticResource Bar.GlyphButton}" Width="44" Height="44" FontSize="18" Content="{Binding PreviousGlyph}"
                        Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" ToolTip="{l:Loc media.previous}" />
                <Button Style="{StaticResource Bar.GlyphButton}" Width="54" Height="54" FontSize="24" Margin="14,0" Content="{Binding PlayPauseGlyph}"
                        Command="{Binding PlayPauseCommand}" ToolTip="{l:Loc media.playPause}" />
                <Button Style="{StaticResource Bar.GlyphButton}" Width="44" Height="44" FontSize="18" Content="{Binding NextGlyph}"
                        Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" ToolTip="{l:Loc media.next}" />
            </StackPanel>
            <!-- This app's own volume, independent of the system volume. -->
            <Grid Margin="0,12,0,0" Visibility="{Binding HasAppVolume, Converter={StaticResource BoolToVisibility}}" ToolTip="{l:Loc media.appVolume}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource Bar.Secondary}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Style="{StaticResource Card.Slider}" Value="{Binding AppVolume}" Margin="8,0" />
                <TextBlock Grid.Column="2" Text="{Binding AppVolume, StringFormat={}{0:0}%}" Style="{StaticResource Card.Label}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Control center ======================================================================= -->
    <DataTemplate x:Key="ControlCenterWidget.Tile" DataType="{x:Type w:ControlCenterWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Network, sound and battery each open their own panel above the icon. -->
            <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding NetworkGlyph}" Command="{Binding OpenNetworkCommand}"
                    ToolTip="{Binding NetworkText}" Width="30" Height="28" FontSize="15" />
            <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding VolumeGlyph}" Command="{Binding OpenSoundCommand}"
                    ToolTip="{Binding VolumeText}" Width="30" Height="28" FontSize="15" />
            <Button Style="{StaticResource Bar.PlainButton}" Command="{Binding OpenBatteryCommand}" ToolTip="{l:Loc cc.battery}"
                    Height="28" Padding="6,0" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding BatteryGlyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Bar.Foreground}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BatteryText}" Style="{StaticResource Bar.SubText}" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding PowerGlyph}" Command="{Binding OpenBatteryCommand}"
                    ToolTip="{l:Loc cc.power}" Width="28" Height="28" FontSize="14"
                    Visibility="{Binding ShowPowerButton, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding GearGlyph}" Command="{Binding OpenQuickSettingsCommand}"
                    ToolTip="{l:Loc control.quickSettings}" Width="28" Height="28" FontSize="13" />
            <Rectangle Width="1" Height="18" Fill="{DynamicResource Bar.Separator}" Margin="10,0,4,0" />
            <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding BellGlyph}" Command="{Binding OpenNotificationsCommand}"
                    ToolTip="{l:Loc control.notifications}" Width="28" Height="28" />
        </StackPanel>
    </DataTemplate>

    <!-- Show desktop / spacer ================================================================ -->
    <DataTemplate x:Key="ShowDesktopWidget.Tile" DataType="{x:Type w:ShowDesktopWidget}">
        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Bar.Foreground}"
                   VerticalAlignment="Center" ToolTip="{l:Loc widget.showdesktop.name}" />
    </DataTemplate>

    <DataTemplate x:Key="SpacerWidget.Tile" DataType="{x:Type w:SpacerWidget}">
        <Border Background="Transparent" />
    </DataTemplate>

    <!-- ====================================================================================== -->
    <!-- Phase 3 widgets                                                                         -->
    <!-- ====================================================================================== -->

    <Style x:Key="Card.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Bar.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Bar.Foreground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Bar.Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource Bar.Track}"
                            BorderBrush="{DynamicResource Bar.TileRim}" BorderThickness="1">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalScrollBarVisibility="Auto" />
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0"
                                       Foreground="{DynamicResource Bar.Secondary}" FontSize="{TemplateBinding FontSize}"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bar.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card.CheckBox" TargetType="CheckBox">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                                BorderBrush="{DynamicResource Bar.Secondary}" VerticalAlignment="Center">
                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Bar.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Bar.Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim glass slider for cards. -->
    <Style x:Key="Card.Slider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Bar.Track}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Bar.Accent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16" Fill="White" Stroke="{DynamicResource Bar.Accent}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pulse ================================================================================ -->
    <DataTemplate x:Key="PulseWidget.Tile" DataType="{x:Type w:PulseWidget}">
        <Border x:Name="Capsule" CornerRadius="10" Padding="8,4" Background="{DynamicResource Bar.Accent}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Headline}" Foreground="White" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                           Margin="8,0,0,0" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border CornerRadius="7" Background="#33FFFFFF" Padding="5,0" Margin="8,0,0,0"
                        Visibility="{Binding CountText, Converter={StaticResource NonEmptyToVisibility}}">
                    <TextBlock Text="{Binding CountText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                <Setter TargetName="Capsule" Property="Background" Value="#E5484D" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="PulseWidget.Card" DataType="{x:Type w:PulseWidget}">
        <StackPanel Width="300">
            <TextBlock Text="{l:Loc pulse.title}" Style="{StaticResource Card.Title}" />
            <TextBlock Text="{l:Loc pulse.subtitle}" Style="{StaticResource Card.Label}" Margin="0,2,0,12" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:PulseRow}">
                        <Border x:Name="Row" CornerRadius="10" Padding="10,8" Margin="0,0,0,6" Background="{DynamicResource Bar.TileFill}"
                                BorderBrush="{DynamicResource Bar.TileRim}" BorderThickness="1">
                            <!-- A click on the row (not on the dismiss button) opens what the alert is about. -->
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource Bar.Accent}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Card.Body}" TextWrapping="Wrap"
                                           TextTrimming="None" Margin="10,0" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="10"
                                        Content="&#xE8BB;" Command="{Binding DismissCommand}" ToolTip="{l:Loc pulse.dismiss}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="#FF6B6F" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanOpen}" Value="True">
                                <Setter TargetName="Row" Property="Cursor" Value="Hand" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanOpen}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bar.HoverFill}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Bar.Accent}" />
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource Card.Button}" Content="{l:Loc pulse.dismissAll}" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Command="{Binding DismissAllCommand}" />
        </StackPanel>
    </DataTemplate>

    <!-- Focus ================================================================================ -->
    <DataTemplate x:Key="FocusWidget.Tile" DataType="{x:Type w:FocusWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="28" Height="28">
                <c:RingGauge x:Name="Ring" Value="{Binding ProgressPercent}" StrokeThickness="3" Track="{DynamicResource Bar.Track}" Fill="{DynamicResource Bar.Accent}" />
            </Grid>
            <StackPanel Margin="8,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Bar.Text}" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                <TextBlock Text="{Binding PhaseText}" Style="{StaticResource Bar.SubText}" />
            </StackPanel>
            <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding ToggleGlyph}" Command="{Binding ToggleCommand}" Width="28" Height="28" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsBreak}" Value="True">
                <Setter TargetName="Ring" Property="Fill" Value="#5EE6C8" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="FocusWidget.Card" DataType="{x:Type w:FocusWidget}">
        <StackPanel Width="270">
            <TextBlock Text="{l:Loc widget.focus.name}" Style="{StaticResource Card.Title}" />
            <TextBlock Text="{Binding RoundsText}" Style="{StaticResource Card.Label}" Margin="0,2,0,14" />
            <Grid Width="150" Height="150" HorizontalAlignment="Center">
                <c:RingGauge x:Name="BigRing" Value="{Binding ProgressPercent}" StrokeThickness="9" Track="{DynamicResource Bar.Track}" Fill="{DynamicResource Bar.Accent}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Bar.Text}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding PhaseText}" Style="{StaticResource Card.Label}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,16">
                <Button Style="{StaticResource Bar.GlyphButton}" Width="40" Height="40" FontSize="14" Content="&#xE72C;" Command="{Binding ResetCommand}" ToolTip="{l:Loc common.reset}" />
                <Button Style="{StaticResource Bar.GlyphButton}" Width="52" Height="52" FontSize="22" Margin="12,0" Content="{Binding ToggleGlyph}" Command="{Binding ToggleCommand}" ToolTip="{l:Loc common.startPause}" />
                <Button Style="{StaticResource Bar.GlyphButton}" Width="40" Height="40" FontSize="14" Content="&#xE893;" Command="{Binding SkipCommand}" ToolTip="{l:Loc focus.skip}" />
            </StackPanel>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{l:Loc focus.focusLength}" Style="{StaticResource Card.Body}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="10" Content="&#xE738;" Command="{Binding ChangeFocusCommand}" CommandParameter="-5" />
                    <TextBlock Text="{Binding FocusMinutes, StringFormat={}{0} min}" Style="{StaticResource Card.Body}" Width="56" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="10" Content="&#xE710;" Command="{Binding ChangeFocusCommand}" CommandParameter="5" />
                </StackPanel>
            </Grid>
            <Grid>
                <TextBlock Text="{l:Loc focus.breakLength}" Style="{StaticResource Card.Body}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="10" Content="&#xE738;" Command="{Binding ChangeBreakCommand}" CommandParameter="-1" />
                    <TextBlock Text="{Binding BreakMinutes, StringFormat={}{0} min}" Style="{StaticResource Card.Body}" Width="56" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="10" Content="&#xE710;" Command="{Binding ChangeBreakCommand}" CommandParameter="1" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsBreak}" Value="True">
                <Setter TargetName="BigRing" Property="Fill" Value="#5EE6C8" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Timer ================================================================================ -->
    <DataTemplate x:Key="TimerWidget.Tile" DataType="{x:Type w:TimerWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <c:RingGauge Width="24" Height="24" Value="{Binding ProgressPercent}" StrokeThickness="3" Track="{DynamicResource Bar.Track}" Fill="{DynamicResource Bar.Accent}" />
            <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Bar.Text}" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                       Margin="8,0,2,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding ToggleGlyph}" Command="{Binding ToggleCommand}" Width="28" Height="28" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TimerWidget.Card" DataType="{x:Type w:TimerWidget}">
        <StackPanel Width="270">
            <TextBlock Text="{l:Loc widget.timer.name}" Style="{StaticResource Card.Title}" />
            <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Bar.Text}" FontFamily="{StaticResource DisplayFont}" FontSize="40"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4" />
            <Border Style="{StaticResource Card.Progress}" Margin="0,0,0,14">
                <Border CornerRadius="3" Background="{DynamicResource Bar.Accent}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding ProgressPercent, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                </Border>
            </Border>
            <TextBlock Text="{l:Loc timer.presets}" Style="{StaticResource Card.Label}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Card.Button}" Margin="2" Padding="4,6" Content="{Binding StringFormat={}{0} min}"
                                Command="{Binding DataContext.StartPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Style="{StaticResource Card.Button}" Content="+1 min" Command="{Binding AddCommand}" CommandParameter="1" Margin="0,0,6,0" />
                <Button Style="{StaticResource Card.Button}" Content="+5 min" Command="{Binding AddCommand}" CommandParameter="5" Margin="0,0,6,0" />
                <Button Style="{StaticResource Bar.GlyphButton}" Width="36" Height="36" Content="{Binding ToggleGlyph}" Command="{Binding ToggleCommand}" ToolTip="{l:Loc common.startPause}" />
                <Button Style="{StaticResource Bar.GlyphButton}" Width="36" Height="36" Content="&#xE72C;" Command="{Binding ResetCommand}" ToolTip="{l:Loc common.reset}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Stopwatch ============================================================================ -->
    <DataTemplate x:Key="StopwatchWidget.Tile" DataType="{x:Type w:StopwatchWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Bar.Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Bar.Text}" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                       Margin="8,0,2,0" VerticalAlignment="Center" MinWidth="44" />
            <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding ToggleGlyph}" Command="{Binding ToggleCommand}" Width="28" Height="28" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="StopwatchWidget.Card" DataType="{x:Type w:StopwatchWidget}">
        <StackPanel Width="260">
            <TextBlock Text="{l:Loc widget.stopwatch.name}" Style="{StaticResource Card.Title}" />
            <TextBlock Text="{Binding PreciseText}" Style="{StaticResource Bar.Text}" FontFamily="{StaticResource DisplayFont}" FontSize="38"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Button Style="{StaticResource Card.Button}" Content="{l:Loc stopwatch.lapButton}" Command="{Binding LapCommand}" Margin="0,0,8,0" MinWidth="70" />
                <Button Style="{StaticResource Bar.GlyphButton}" Width="44" Height="44" FontSize="18" Content="{Binding ToggleGlyph}" Command="{Binding ToggleCommand}" />
                <Button Style="{StaticResource Card.Button}" Content="{l:Loc common.reset}" Command="{Binding ResetCommand}" Margin="8,0,0,0" MinWidth="70" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Laps}" MaxHeight="200">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:LapRow}">
                        <Grid Margin="0,3">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Card.Label}" />
                            <TextBlock Text="{Binding Time}" Style="{StaticResource Card.Body}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- To-dos =============================================================================== -->
    <DataTemplate x:Key="TodosWidget.Tile" DataType="{x:Type w:TodosWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="26" Height="26">
                <c:RingGauge Value="{Binding DonePercent}" StrokeThickness="3" Track="{DynamicResource Bar.Track}" Fill="#5EE6C8" />
                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource Bar.Foreground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="170">
                <TextBlock Text="{Binding NextText}" Style="{StaticResource Bar.Text}" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Bar.SubText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TodosWidget.Card" DataType="{x:Type w:TodosWidget}">
        <StackPanel Width="300">
            <Grid>
                <TextBlock Text="{l:Loc widget.todos.name}" Style="{StaticResource Card.Title}" />
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Card.Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBox Style="{StaticResource Card.TextBox}" Margin="0,10,0,10" Tag="{l:Loc todos.addHint}"
                     Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ItemsControl ItemsSource="{Binding Items}" MaxHeight="260">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:TodoRowViewModel}">
                        <Grid Margin="0,3">
                            <CheckBox Style="{StaticResource Card.CheckBox}" IsChecked="{Binding Done}" Margin="0,0,30,0">
                                <TextBlock x:Name="Label" Text="{Binding Text}" Style="{StaticResource Card.Body}" TextWrapping="Wrap" TextTrimming="None" />
                            </CheckBox>
                            <Button Style="{StaticResource Bar.GlyphButton}" Width="24" Height="24" FontSize="10" HorizontalAlignment="Right"
                                    Content="&#xE74D;" Command="{Binding DeleteCommand}" ToolTip="{l:Loc common.delete}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="Label" Property="Opacity" Value="0.5" />
                                <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource Card.Button}" Content="{l:Loc todos.clearDone}" HorizontalAlignment="Left" Margin="0,10,0,0"
                    Command="{Binding ClearCompletedCommand}" />
        </StackPanel>
    </DataTemplate>

    <!-- Notes ================================================================================ -->
    <DataTemplate x:Key="NotesWidget.Tile" DataType="{x:Type w:NotesWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#FFD166" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Preview}" Style="{StaticResource Bar.Text}" FontSize="12.5" Margin="8,0,0,0" MaxWidth="170" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NotesWidget.Card" DataType="{x:Type w:NotesWidget}">
        <StackPanel Width="320">
            <TextBlock Text="{l:Loc widget.notes.name}" Style="{StaticResource Card.Title}" />
            <TextBlock Text="{l:Loc notes.autosave}" Style="{StaticResource Card.Label}" Margin="0,2,0,10" />
            <TextBox Style="{StaticResource Card.TextBox}" Height="220" AcceptsReturn="True" TextWrapping="Wrap" Tag="{l:Loc notes.hint}"
                     VerticalContentAlignment="Top" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </DataTemplate>

    <!-- Volume / microphone =================================================================== -->
    <DataTemplate x:Key="VolumeWidget.Tile" DataType="{x:Type w:VolumeWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{l:Loc volume.tip}">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Bar.Foreground}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PercentText}" Style="{StaticResource Bar.Text}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="VolumeWidget.Card" DataType="{x:Type w:VolumeWidget}">
        <StackPanel Width="280">
            <TextBlock Text="{l:Loc widget.volume.name}" Style="{StaticResource Card.Title}" />
            <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Card.Label}" Margin="0,2,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding Glyph}" Command="{Binding ToggleMuteCommand}" ToolTip="{l:Loc volume.mute}" />
                <Slider Grid.Column="1" Style="{StaticResource Card.Slider}" Value="{Binding Volume}" Margin="8,0" />
                <TextBlock Grid.Column="2" Text="{Binding PercentText}" Style="{StaticResource Card.Body}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,14,0,0" Visibility="{Binding MicAvailable, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{l:Loc widget.microphone.name}" Style="{StaticResource Card.Body}" VerticalAlignment="Center" />
                <Button Style="{StaticResource Card.Button}" HorizontalAlignment="Right" Command="{Binding ToggleMicCommand}">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:Loc mic.mute}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MicMuted}" Value="True">
                                            <Setter Property="Text" Value="{l:Loc mic.unmute}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="MicrophoneWidget.Tile" DataType="{x:Type w:MicrophoneWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding StateText}">
            <TextBlock x:Name="Mic" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{DynamicResource Bar.Foreground}" VerticalAlignment="Center" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Muted}" Value="True">
                <Setter TargetName="Mic" Property="Foreground" Value="#FF6B6F" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Network ============================================================================== -->
    <DataTemplate x:Key="NetworkWidget.Tile" DataType="{x:Type w:NetworkWidget}">
        <StackPanel VerticalAlignment="Center" MinWidth="70">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#5EE6C8" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DownText}" Style="{StaticResource Bar.Text}" FontSize="11.5" FontWeight="SemiBold" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource Bar.Accent}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding UpText}" Style="{StaticResource Bar.SubText}" FontSize="11" Margin="4,0,0,0" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NetworkWidget.Card" DataType="{x:Type w:NetworkWidget}">
        <StackPanel Width="280">
            <TextBlock Text="{l:Loc widget.network.name}" Style="{StaticResource Card.Title}" />
            <TextBlock Text="{Binding Adapters}" Style="{StaticResource Card.Label}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />
            <Grid Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{l:Loc network.down}" Style="{StaticResource Card.Label}" />
                    <TextBlock Text="{Binding DownText}" Style="{StaticResource Card.Title}" Foreground="#5EE6C8" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="{l:Loc network.up}" Style="{StaticResource Card.Label}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding UpText}" Style="{StaticResource Card.Title}" Foreground="{DynamicResource Bar.Accent}" />
                </StackPanel>
            </Grid>
            <Border CornerRadius="8" Background="{DynamicResource Bar.Track}" Padding="10">
                <Grid Width="260" Height="70" ClipToBounds="True">
                    <Polygon Points="{Binding DownPoints}" Fill="#405EE6C8" Stroke="#5EE6C8" StrokeThickness="1.5" />
                    <Polygon Points="{Binding UpPoints}" Fill="#308AB4FF" Stroke="{DynamicResource Bar.Accent}" StrokeThickness="1.2" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding PeakText}" Style="{StaticResource Card.Label}" FontSize="11" Margin="0,6,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Storage / recycle bin ================================================================= -->
    <DataTemplate x:Key="StorageWidget.Tile" DataType="{x:Type w:StorageWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Bar.Foreground}" VerticalAlignment="Center" />
            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" Width="74">
                <TextBlock Text="{Binding FreeText}" Style="{StaticResource Bar.Text}" FontSize="12" FontWeight="SemiBold" />
                <Border Style="{StaticResource Card.Progress}" Height="4" Margin="0,3,0,0">
                    <Border CornerRadius="2" Background="{DynamicResource Bar.Accent}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding UsedPercent, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="StorageWidget.Card" DataType="{x:Type w:StorageWidget}">
        <StackPanel Width="280">
            <TextBlock Text="{l:Loc widget.storage.name}" Style="{StaticResource Card.Title}" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:DriveRow}">
                        <StackPanel Margin="0,0,0,12">
                            <Grid>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Card.Body}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding UsedPercent, StringFormat={}{0:0}%}" Style="{StaticResource Card.Label}" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource Card.Progress}" Margin="0,5,0,3">
                                <Border x:Name="Fill" CornerRadius="3" Background="{DynamicResource Bar.Accent}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding UsedPercent, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                                </Border>
                            </Border>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Card.Label}" FontSize="11" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLow}" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#FF6B6F" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource Card.Button}" Content="{l:Loc storage.openThisPc}" HorizontalAlignment="Left" Command="{Binding OpenThisPcCommand}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="RecycleBinWidget.Tile" DataType="{x:Type w:RecycleBinWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding DetailText}">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Bar.Foreground}" VerticalAlignment="Center" />
            <TextBlock x:Name="Count" Text="{Binding CountText}" Style="{StaticResource Bar.Text}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="RecycleBinWidget.Card" DataType="{x:Type w:RecycleBinWidget}">
        <StackPanel Width="260">
            <TextBlock Text="{l:Loc widget.recyclebin.name}" Style="{StaticResource Card.Title}" />
            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Card.Body}" Margin="0,6,0,14" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Card.Button}" Content="{l:Loc bin.open}" Command="{Binding OpenCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Card.Button}" Content="{l:Loc bin.emptyAction}" Command="{Binding EmptyCommand}"
                        IsEnabled="{Binding IsEmpty, Converter={StaticResource InverseBool}}" />
            </StackPanel>
            <TextBlock Text="{l:Loc bin.confirmNote}" Style="{StaticResource Card.Label}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
    </DataTemplate>


    <DataTemplate x:Key="RadioToggleView" DataType="{x:Type w:RadioToggleViewModel}">
        <Button Command="{Binding ToggleCommand}" ToolTip="{Binding Label}" Width="30" Height="28"
                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Bar.PlainButton}">
                    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
            </Button.Style>
            <Border x:Name="Plate" Width="28" Height="24" CornerRadius="7" Background="Transparent">
                <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{DynamicResource Bar.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOn}" Value="True">
                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Bar.Accent}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <!-- Keyboard / toggles / brightness ======================================================= -->
    <DataTemplate x:Key="KeyboardWidget.Tile" DataType="{x:Type w:KeyboardWidget}">
        <Border CornerRadius="5" BorderThickness="1.2" BorderBrush="{DynamicResource Bar.Secondary}" Padding="5,1" VerticalAlignment="Center"
                ToolTip="{Binding LayoutName}">
            <TextBlock Text="{Binding Short}" Style="{StaticResource Bar.Text}" FontSize="11.5" FontWeight="Bold" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="QuickTogglesWidget.Tile" DataType="{x:Type w:QuickTogglesWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ContentPresenter Content="{Binding WiFi}" ContentTemplate="{StaticResource RadioToggleView}" />
            <ContentPresenter Content="{Binding Bluetooth}" ContentTemplate="{StaticResource RadioToggleView}" Margin="4,0,0,0" />
            <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding MoreGlyph}" Command="{Binding OpenQuickSettingsCommand}"
                    Width="26" Height="28" FontSize="12" ToolTip="{l:Loc control.quickSettings}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="BrightnessWidget.Tile" DataType="{x:Type w:BrightnessWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{l:Loc brightness.tip}">
            <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#FFD166" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PercentText}" Style="{StaticResource Bar.Text}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="BrightnessWidget.Card" DataType="{x:Type w:BrightnessWidget}">
        <StackPanel Width="280">
            <TextBlock Text="{l:Loc widget.brightness.name}" Style="{StaticResource Card.Title}" Margin="0,0,0,10" />
            <TextBlock Text="{l:Loc common.loading}" Style="{StaticResource Card.Label}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{l:Loc brightness.unsupported}" Style="{StaticResource Card.Label}" TextWrapping="Wrap" TextTrimming="None">
                <TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource AllFalseToVisibility}">
                        <Binding Path="IsLoading" />
                        <Binding Path="IsSupported" />
                    </MultiBinding>
                </TextBlock.Visibility>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Displays}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:BrightnessRowViewModel}">
                        <StackPanel Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Card.Body}" />
                                <TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}" Style="{StaticResource Card.Label}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Style="{StaticResource Card.Slider}" Value="{Binding Percent}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>


    <!-- Claude usage =========================================================================== -->
    <Geometry x:Key="SparkleGeometry">M12,1.5 C12.7,8 16,11.3 22.5,12 C16,12.7 12.7,16 12,22.5 C11.3,16 8,12.7 1.5,12 C8,11.3 11.3,8 12,1.5 Z</Geometry>
    <LinearGradientBrush x:Key="SparkleBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB48A" Offset="0" />
        <GradientStop Color="#E5734A" Offset="1" />
    </LinearGradientBrush>

    <DataTemplate x:Key="ClaudeWidget.Tile" DataType="{x:Type w:ClaudeWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="30" Height="30">
                <c:RingGauge Value="{Binding RingValue}" StrokeThickness="2.5" Track="{DynamicResource Bar.Track}" Fill="{StaticResource SparkleBrush}" />
                <Path Data="{StaticResource SparkleGeometry}" Fill="{StaticResource SparkleBrush}" Stretch="Uniform" Width="15" Height="15" />
            </Grid>
            <StackPanel Margin="8,0,2,0" VerticalAlignment="Center" MaxWidth="150">
                <TextBlock Text="{Binding Headline}" Style="{StaticResource Bar.Text}" FontWeight="SemiBold" FontSize="12.5" />
                <TextBlock Text="{Binding Subline}" Style="{StaticResource Bar.SubText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ClaudeWidget.Card" DataType="{x:Type w:ClaudeWidget}">
        <StackPanel Width="300">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource SparkleGeometry}" Fill="{StaticResource SparkleBrush}" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="Claude" Style="{StaticResource Card.Title}" Margin="8,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="11" HorizontalAlignment="Right"
                        Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="{l:Loc common.refresh}" />
            </Grid>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Card.Label}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                       Visibility="{Binding StatusText, Converter={StaticResource NonEmptyToVisibility}}" />

            <!-- Plan limits, as Claude reports them -->
            <Border CornerRadius="12" Padding="14,12" Margin="0,12,0,0" Background="{DynamicResource Bar.TileFill}"
                    BorderBrush="{DynamicResource Bar.TileRim}" BorderThickness="1" Visibility="{Binding HasLimits, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{l:Loc claude.limits}" Style="{StaticResource Card.Label}" />
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasFiveHour, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBlock Text="{l:Loc claude.fiveHour}" Style="{StaticResource Card.Body}" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding FiveHourText}" Style="{StaticResource Bar.Text}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Style="{StaticResource Card.Progress}" Margin="0,4,0,0">
                            <Border CornerRadius="3" Background="{StaticResource SparkleBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding FiveHourPercent, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock Text="{Binding FiveHourReset}" Style="{StaticResource Card.Label}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasWeekly, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBlock Text="{l:Loc claude.weekly}" Style="{StaticResource Card.Body}" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding WeeklyText}" Style="{StaticResource Bar.Text}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Style="{StaticResource Card.Progress}" Margin="0,4,0,0">
                            <Border CornerRadius="3" Background="{StaticResource SparkleBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding WeeklyPercent, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock Text="{Binding WeeklyReset}" Style="{StaticResource Card.Label}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Current 5-hour window -->
            <Border CornerRadius="12" Padding="14,12" Margin="0,12,0,0" Background="{DynamicResource Bar.TileFill}"
                    BorderBrush="{DynamicResource Bar.TileRim}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{l:Loc claude.session}" Style="{StaticResource Card.Label}" />
                    <StackPanel Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SessionTokens}" Style="{StaticResource Bar.Text}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Text="{l:Loc claude.tokens}" Style="{StaticResource Card.Label}" />
                            </StackPanel>
                            <Grid Width="58" Height="58" HorizontalAlignment="Right" ToolTip="{l:Loc claude.windowTip}">
                                <c:RingGauge Value="{Binding WindowProgress}" StrokeThickness="5" Track="{DynamicResource Bar.Track}" Fill="{StaticResource SparkleBrush}" />
                                <Path Data="{StaticResource SparkleGeometry}" Fill="{StaticResource SparkleBrush}" Stretch="Uniform" Width="20" Height="20" />
                            </Grid>
                        </Grid>
                        <TextBlock Text="{Binding SessionMessages}" Style="{StaticResource Card.Body}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SessionTimes}" Style="{StaticResource Card.Label}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SessionCache}" Style="{StaticResource Card.Label}" FontSize="11" Margin="0,2,0,0" />
                        <StackPanel Visibility="{Binding HasRecord, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                            <Border Style="{StaticResource Card.Progress}">
                                <Border CornerRadius="3" Background="{StaticResource SparkleBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding RecordShare, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                                </Border>
                            </Border>
                            <TextBlock Text="{Binding RecordText}" Style="{StaticResource Card.Label}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{l:Loc claude.noSession}" Style="{StaticResource Card.Body}" Margin="0,4,0,0"
                               Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Today and the last seven days -->
            <TextBlock Text="{Binding TodayText}" Style="{StaticResource Card.Body}" Margin="0,14,0,0" />
            <TextBlock Text="{Binding WeekText}" Style="{StaticResource Card.Label}" Margin="0,2,0,8" />
            <ItemsControl ItemsSource="{Binding Days}" Height="86">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:UsageBar}">
                        <Grid Margin="4,0" ToolTip="{Binding ToolTip}" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border CornerRadius="4" Background="{DynamicResource Bar.Track}" Opacity="0.3" />
                            <Border x:Name="Bar" CornerRadius="4" Background="{DynamicResource Bar.Secondary}" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform><ScaleTransform ScaleY="{Binding HeightPercent, Converter={StaticResource PercentToScale}}" /></Border.RenderTransform>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding Label}" Style="{StaticResource Card.Label}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource SparkleBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{l:Loc claude.models}" Style="{StaticResource Card.Label}" FontWeight="SemiBold" Margin="0,14,0,2" />
            <ItemsControl ItemsSource="{Binding Models}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:ModelRow}">
                        <Grid Margin="0,2">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Card.Body}" FontSize="12.5" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Card.Label}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{l:Loc claude.note}" Style="{StaticResource Card.Label}" FontSize="10.5" Margin="0,12,0,0" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
    </DataTemplate>


    <!-- Overflow ("»") ========================================================================= -->
    <DataTemplate x:Key="OverflowWidget.Card" DataType="{x:Type w:OverflowWidget}">
        <StackPanel MaxWidth="560">
            <TextBlock Text="{l:Loc bar.moreTitle}" Style="{StaticResource Card.Title}" />
            <TextBlock Text="{l:Loc bar.moreHint}" Style="{StaticResource Card.Label}" Margin="0,2,0,12" TextWrapping="Wrap" TextTrimming="None" />
            <ItemsControl ItemsSource="{Binding Hidden}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="{DynamicResource Bar.TileHeight}" CornerRadius="{DynamicResource Bar.TileRadius}" Padding="{DynamicResource Bar.TilePadding}"
                                Background="{DynamicResource Bar.TileFill}" BorderBrush="{DynamicResource Bar.TileRim}" BorderThickness="1" Margin="0,0,8,8">
                            <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource TileSelector}" VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- ====================================================================================== -->
    <!-- Phase 4: calendar (Google Calendar / iCal)                                              -->
    <!-- ====================================================================================== -->

    <!-- Agenda for the coming week, or the form that connects a calendar. -->
    <DataTemplate x:Key="AgendaView" DataType="{x:Type svc:CalendarFeed}">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource Bar.Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="{l:Loc calendar.title}" Style="{StaticResource Card.Body}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="11"
                            Content="&#xE8A7;" Command="{Binding OpenGoogleCalendarCommand}" ToolTip="{l:Loc calendar.openGoogle}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="11"
                            Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="{l:Loc common.refresh}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="11"
                            Content="&#xE713;" Command="{Binding ManageCommand}" ToolTip="{l:Loc calendar.manage}" />
                </StackPanel>
            </Grid>

            <!-- Nothing connected yet -->
            <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,10,0,0">
                <TextBlock Text="{l:Loc calendar.connectIntro}" Style="{StaticResource Card.Label}" TextWrapping="Wrap" TextTrimming="None" />
                <Button Style="{StaticResource Card.Button}" Content="{l:Loc calendar.connectButton}" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Command="{Binding ManageCommand}" />
            </StackPanel>

            <!-- The coming week -->
            <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Card.Label}" Foreground="#FF8A80" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                           Visibility="{Binding ErrorText, Converter={StaticResource NonEmptyToVisibility}}" />
                <TextBlock Text="{l:Loc calendar.noEvents}" Style="{StaticResource Card.Label}" Margin="0,10,0,0"
                           Visibility="{Binding HasNoEvents, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Days}" MaxHeight="320" Margin="0,6,0,0">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:AgendaDay}">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding Header}" Style="{StaticResource Card.Label}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type svc:AgendaItem}">
                                            <Grid Margin="0,2" ToolTip="{Binding CalendarName}" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="1.5" Background="{Binding Color}" />
                                                <StackPanel Grid.Column="1" Margin="8,1,0,1">
                                                    <TextBlock x:Name="Title" Text="{Binding Title}" Style="{StaticResource Card.Body}" FontSize="12.5" />
                                                    <TextBlock Style="{StaticResource Card.Label}" FontSize="11">
                                                        <Run Text="{Binding Time, Mode=OneWay}" /><Run Text="{Binding Location, Mode=OneWay, StringFormat={} · {0}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsNow}" Value="True">
                                                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Card.Label}" FontSize="11" Margin="0,10,0,0" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="AgendaWidget.Tile" DataType="{x:Type w:AgendaWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="26" Height="26">
                <Border x:Name="Plate" CornerRadius="7" Background="{DynamicResource Bar.Track}" />
                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Bar.Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Margin="8,0,2,0" VerticalAlignment="Center" MaxWidth="170">
                <TextBlock Text="{Binding Feed.NextTitle}" Style="{StaticResource Bar.Text}" FontWeight="SemiBold" FontSize="12.5" />
                <TextBlock x:Name="When" Text="{Binding Feed.NextWhen}" Style="{StaticResource Bar.SubText}"
                           Visibility="{Binding Feed.NextWhen, Converter={StaticResource NonEmptyToVisibility}}" />
            </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Feed.IsNextNow}" Value="True">
                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Bar.Accent}" />
                <Setter TargetName="Plate" Property="Opacity" Value="0.35" />
                <Setter TargetName="When" Property="Foreground" Value="{DynamicResource Bar.Foreground}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="AgendaWidget.Card" DataType="{x:Type w:AgendaWidget}">
        <StackPanel Width="300">
            <ContentPresenter Content="{Binding Feed}" ContentTemplate="{StaticResource AgendaView}" />
        </StackPanel>
    </DataTemplate>

    <!-- ====================================================================================== -->
    <!-- Phase 4: notification icons (background apps)                                           -->
    <!-- ====================================================================================== -->

    <DataTemplate x:Key="TrayIconView" DataType="{x:Type svc:TrayIconItem}">
        <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True" UseLayoutRounding="True" />
    </DataTemplate>

    <DataTemplate x:Key="TrayWidget.Tile" DataType="{x:Type w:TrayWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Host.Pinned}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type svc:TrayIconItem}">
                        <c:TrayIconButton Style="{StaticResource Bar.PlainButton}" Width="26" Height="28" ToolTip="{Binding Title}"
                                          Host="{Binding DataContext.Host, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          Content="{Binding}" ContentTemplate="{StaticResource TrayIconView}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Width="24" Height="28" Background="Transparent" ToolTip="{l:Loc tray.show}">
                <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Bar.Foreground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TrayWidget.Card" DataType="{x:Type w:TrayWidget}">
        <StackPanel Width="264">
            <Grid>
                <TextBlock Text="{l:Loc tray.title}" Style="{StaticResource Card.Title}" />
                <Button x:Name="EditButton" Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="12" HorizontalAlignment="Right"
                        Content="&#xE718;" Command="{Binding ToggleEditingCommand}" ToolTip="{l:Loc tray.edit}" />
            </Grid>
            <TextBlock Text="{l:Loc tray.editHint}" Style="{StaticResource Card.Label}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"
                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{l:Loc tray.unavailable}" Style="{StaticResource Card.Label}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                       Visibility="{Binding Host.IsAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBlock Text="{l:Loc tray.empty}" Style="{StaticResource Card.Label}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                       Visibility="{Binding Host.HasIcons, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Host.All}" Margin="-4,8,-4,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type svc:TrayIconItem}">
                        <Grid Width="44" Height="40">
                            <Border x:Name="PinPlate" CornerRadius="9" Margin="2" Background="{DynamicResource Bar.HoverFill}" Visibility="Collapsed" />
                            <c:TrayIconButton Style="{StaticResource Bar.PlainButton}" ToolTip="{Binding Title}"
                                              IsEditing="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              Host="{Binding DataContext.Host, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True" UseLayoutRounding="True" />
                            </c:TrayIconButton>
                            <Ellipse x:Name="PinDot" Width="5" Height="5" Fill="{DynamicResource Bar.Accent}" VerticalAlignment="Bottom"
                                     HorizontalAlignment="Center" Margin="0,0,0,3" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="PinDot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPinned}" Value="True" />
                                    <Condition Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="PinPlate" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                <Setter TargetName="EditButton" Property="Content" Value="&#xE73E;" />
                <Setter TargetName="EditButton" Property="ToolTip" Value="{l:Loc tray.done}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ====================================================================================== -->
    <!-- Clipboard history                                                                       -->
    <!-- ====================================================================================== -->

    <DataTemplate x:Key="ClipboardWidget.Tile" DataType="{x:Type w:ClipboardWidget}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Bar.Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Clipboard.Count}" Style="{StaticResource Bar.Text}" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ClipboardWidget.Card" DataType="{x:Type w:ClipboardWidget}">
        <StackPanel Width="340" DataContext="{Binding Clipboard}">
            <Grid>
                <TextBlock Text="{l:Loc widget.clipboard.name}" Style="{StaticResource Card.Title}" />
                <Button Style="{StaticResource Card.Button}" Content="{l:Loc clipboard.clear}" HorizontalAlignment="Right" Command="{Binding ClearAllCommand}" />
            </Grid>
            <TextBlock Text="{l:Loc clipboard.off}" Style="{StaticResource Card.Label}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                       Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBox Style="{StaticResource Card.TextBox}" Margin="0,10,0,8" Tag="{l:Loc clipboard.search}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
            <ItemsControl ItemsSource="{Binding Items}" MaxHeight="380">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type svc:ClipRow}">
                        <Grid Margin="0,2">
                            <Button Style="{StaticResource Bar.PlainButton}" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,0,56,0"
                                    Command="{Binding DataContext.PasteRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="{l:Loc clipboard.pasteTip}">
                                <StackPanel HorizontalAlignment="Left">
                                    <Image Source="{Binding Thumbnail}" MaxHeight="64" MaxWidth="200" HorizontalAlignment="Left" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource Card.Body}" FontSize="12.5" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Card.Label}" FontSize="10.5" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="Pin" Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="11" Content="&#xE718;" Opacity="0.55"
                                        Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        ToolTip="{l:Loc clipboard.pin}" />
                                <Button Style="{StaticResource Bar.GlyphButton}" Width="26" Height="26" FontSize="10" Content="&#xE74D;" Opacity="0.55"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        ToolTip="{l:Loc common.delete}" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="Pin" Property="Opacity" Value="1" />
                                <Setter TargetName="Pin" Property="Foreground" Value="{DynamicResource Bar.Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{l:Loc clipboard.cardHint}" Style="{StaticResource Card.Label}" FontSize="11" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- System panels (network, sound, battery) ============================================ -->
    <Style x:Key="Card.PasswordBox" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Bar.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Bar.Foreground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Bar.Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource Bar.Track}"
                            BorderBrush="{DynamicResource Bar.TileRim}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bar.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A pill that lights up in the accent colour while its Tag is True. -->
    <Style x:Key="Card.Pill" TargetType="Button" BasedOn="{StaticResource Bar.PlainButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="14" Padding="12,5" Background="{DynamicResource Bar.Track}"
                            BorderBrush="{DynamicResource Bar.TileRim}" BorderThickness="1">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource Bar.Foreground}" TextElement.FontSize="12" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bar.HoverFill}" />
                        </Trigger>
                        <Trigger Property="Tag">
                            <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bar.Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bar.Accent}" />
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="#FF0B0F18" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full-width list row: content stretches, the hover plate lights up without zooming. -->
    <Style x:Key="Card.RowButton" TargetType="Button" BasedOn="{StaticResource Bar.PlainButton}">
        <Setter Property="b:HoverMotion.IsEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Plate" Opacity="0" CornerRadius="8" Background="{DynamicResource Bar.HoverFill}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card.Section" TargetType="TextBlock" BasedOn="{StaticResource Card.Label}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <Style x:Key="Card.Link" TargetType="Button" BasedOn="{StaticResource Bar.PlainButton}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="-6,10,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Bar.Accent}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <DataTemplate x:Key="ControlCenterWidget.Card" DataType="{x:Type w:ControlCenterWidget}">
        <Grid Width="340">

            <!-- Network ................................................................... -->
            <StackPanel Visibility="{Binding IsNetworkPanel, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <TextBlock Text="{l:Loc cc.network}" Style="{StaticResource Card.Title}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding HasWifi, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding RefreshGlyph}" Command="{Binding RescanCommand}"
                                ToolTip="{l:Loc cc.rescan}" Width="28" Height="28" FontSize="12" Margin="0,0,6,0" />
                        <Button Style="{StaticResource Card.Pill}" Command="{Binding ToggleWifiCommand}" Tag="{Binding WifiOn}" Content="Wi-Fi" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Connections}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type w:ConnectionRow}">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Bar.Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Card.Body}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Card.Label}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding HasWifi, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:Loc cc.wifiNetworks}" Style="{StaticResource Card.Section}" />
                    <TextBlock Text="{Binding WifiMessage}" Style="{StaticResource Card.Label}" TextWrapping="Wrap" TextTrimming="None"
                               Visibility="{Binding WifiMessage, Converter={StaticResource NonEmptyToVisibility}}" />
                    <Button Style="{StaticResource Card.Button}" Content="{l:Loc cc.allowLocation}" Command="{Binding AllowLocationCommand}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding NeedsLocation, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Networks}" MaxHeight="330">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type w:WifiRow}">
                                <Border x:Name="Row" CornerRadius="8" Margin="0,1" Background="Transparent">
                                    <StackPanel>
                                        <Button Style="{StaticResource Card.RowButton}" Command="{Binding ToggleCommand}" Padding="6,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="Signal" Text="{Binding SignalGlyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Bar.Foreground}" />
                                                    <TextBlock Text="{Binding LockGlyph}" FontFamily="{StaticResource IconFont}" FontSize="7" Foreground="{DynamicResource Bar.Foreground}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-2"
                                                               Visibility="{Binding IsSecured, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Ssid}" Style="{StaticResource Card.Body}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Card.Label}" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <StackPanel Margin="34,0,6,8" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                            <PasswordBox x:Name="Pw" Style="{StaticResource Card.PasswordBox}" Margin="0,2,0,8" ToolTip="{l:Loc cc.password}"
                                                         Visibility="{Binding NeedsPassword, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Card.Label}" FontSize="11" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6"
                                                       Visibility="{Binding Status, Converter={StaticResource NonEmptyToVisibility}}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource Card.Button}" Content="{l:Loc cc.connect}" Command="{Binding ConnectCommand}"
                                                        CommandParameter="{Binding ElementName=Pw}" IsDefault="True"
                                                        Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}"
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                                <Button Style="{StaticResource Card.Button}" Content="{l:Loc cc.disconnect}" Command="{Binding DisconnectCommand}"
                                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter TargetName="Signal" Property="Foreground" Value="{DynamicResource Bar.Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bar.HoverFill}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Card.Link}" Content="{l:Loc cc.moreWifi}" Command="{Binding WifiSettingsCommand}" />
                    <Button Style="{StaticResource Card.Link}" Content="{l:Loc cc.windowsList}" Command="{Binding WindowsNetworksCommand}" Margin="10,10,0,0"
                            Visibility="{Binding HasWifi, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>

            <!-- Sound ..................................................................... -->
            <StackPanel Visibility="{Binding IsSoundPanel, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{l:Loc cc.sound}" Style="{StaticResource Card.Title}" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Bar.GlyphButton}" Content="{Binding MasterGlyph}" Command="{Binding ToggleMasterMuteCommand}" ToolTip="{l:Loc volume.mute}" />
                    <Slider Grid.Column="1" Style="{StaticResource Card.Slider}" Value="{Binding MasterVolume}" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding MasterVolume, StringFormat={}{0:0}}" Style="{StaticResource Card.Body}" Width="30" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="{l:Loc cc.output}" Style="{StaticResource Card.Section}" />
                <ItemsControl ItemsSource="{Binding Outputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type w:OutputRow}">
                            <Button Style="{StaticResource Card.RowButton}" Command="{Binding SelectCommand}" Padding="6,6" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Bar.Foreground}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Card.Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="Check" Grid.Column="2" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Bar.Accent}"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Bar.Accent}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{l:Loc cc.mixer}" Style="{StaticResource Card.Section}" />
                <TextBlock Text="{l:Loc cc.noApps}" Style="{StaticResource Card.Label}" Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Apps}" MaxHeight="260">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type w:AppAudioRow}">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image Grid.RowSpan="2" Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.RowSpan="2" Text="{Binding FallbackGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource Bar.Secondary}"
                                           VerticalAlignment="Center" Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Card.Label}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <Slider Grid.Column="1" Grid.Row="1" Style="{StaticResource Card.Slider}" Value="{Binding Volume}" />
                                <Button x:Name="Mute" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Bar.GlyphButton}" Content="{Binding MuteGlyph}"
                                        Command="{Binding ToggleMuteCommand}" Width="28" Height="28" FontSize="13" Margin="6,0,0,0" ToolTip="{l:Loc volume.mute}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Muted}" Value="True">
                                    <Setter TargetName="Mute" Property="Foreground" Value="#FF6B6F" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource Card.Link}" Content="{l:Loc cc.soundSettings}" Command="{Binding SoundSettingsCommand}" />
            </StackPanel>

            <!-- Battery ................................................................... -->
            <StackPanel Visibility="{Binding IsBatteryPanel, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding PowerTitle}" Style="{StaticResource Card.Title}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BatteryGlyph}" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource Bar.Foreground}" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0} %}" Style="{StaticResource Card.Body}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BatteryStatus}" Style="{StaticResource Card.Label}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{l:Loc cc.saverOn}" Style="{StaticResource Card.Label}" Margin="0,8,0,0" Foreground="#FFD166"
                           Visibility="{Binding SaverOn, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{l:Loc cc.powerHint}" Style="{StaticResource Card.Label}" FontSize="11" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                           Visibility="{Binding HasBattery, Converter={StaticResource InverseBoolToVisibility}}" />
                <StackPanel Visibility="{Binding HasPowerModes, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:Loc cc.powerMode}" Style="{StaticResource Card.Section}" />
                    <UniformGrid Columns="3">
                        <Button Style="{StaticResource Card.Pill}" Content="{l:Loc cc.modeEfficiency}" Tag="{Binding IsEfficiency}"
                                Command="{Binding SetPowerModeCommand}" CommandParameter="Efficiency" Margin="0,0,4,0" />
                        <Button Style="{StaticResource Card.Pill}" Content="{l:Loc cc.modeBalanced}" Tag="{Binding IsBalanced}"
                                Command="{Binding SetPowerModeCommand}" CommandParameter="Balanced" Margin="2,0" />
                        <Button Style="{StaticResource Card.Pill}" Content="{l:Loc cc.modePerformance}" Tag="{Binding IsPerformance}"
                                Command="{Binding SetPowerModeCommand}" CommandParameter="Performance" Margin="4,0,0,0" />
                    </UniformGrid>
                </StackPanel>
                <Button Style="{StaticResource Card.Link}" Content="{l:Loc cc.powerSettings}" Command="{Binding PowerSettingsCommand}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
